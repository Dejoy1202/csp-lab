COMPOSE_PROJECT_NAME=csp-lab
API_PORT=8080
MYSQL_DATABASE=csp_lab
MYSQL_ROOT_PASSWORD=replace-with-a-long-root-password
MYSQL_USER=csp
MYSQL_PASSWORD=replace-with-a-long-db-password
API_KEY=replace-with-a-long-local-api-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SANDBOX_IMAGE=csp-lab-sandbox:local
WORKER_POLL_SECONDS=0.5

# First startup only; change the password after signing in.
ADMIN_USERNAME=cspadmin
ADMIN_INITIAL_PASSWORD=replace-with-a-long-random-password
